{
  "manifest_version": 3,
  "name": "note #検索",
  "version": "1.0.0",
  "description": "noteの検索欄に「#検索」を追加し、タグ名を新しい順で広く探します。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "note #検索",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://note.com/*", "https://www.note.com/*"],
      "js": ["src/page.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "type": "module",
      "world": "MAIN"
    },
    {
      "matches": ["https://note.com/*", "https://www.note.com/*"],
      "js": ["src/storage-bridge.js"],
      "run_at": "document_start",
      "type": "module"
    }
  ]
}
